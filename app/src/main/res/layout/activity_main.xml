<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ix_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtLicenseChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="@string/about_license_loading"
                android:textColor="@color/ix_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtStatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="@string/sdk_loading"
                android:textColor="@color/ix_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/group_attribute_liveness"
            android:textColor="@color/ix_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/panelAttribute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnFaceDetect"
                    style="@style/FaceModeCell"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/mode_face_detect"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/ix_accent" />

                    <TextView
                        style="@style/FaceModeCellLabel"
                        android:text="@string/mode_face_detect" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnFaceAttribute"
                    style="@style/FaceModeCell"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/mode_face_attribute"
                        android:src="@drawable/ic_attribute"
                        android:tint="@color/ix_accent" />

                    <TextView
                        style="@style/FaceModeCellLabel"
                        android:text="@string/mode_face_attribute" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnImageQuality"
                    style="@style/FaceModeCell"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/mode_image_quality"
                        android:src="@drawable/ic_quality"
                        android:tint="@color/ix_accent" />

                    <TextView
                        style="@style/FaceModeCellLabel"
                        android:text="@string/mode_image_quality" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnLandmarks"
                    style="@style/FaceModeCell"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/mode_landmarks"
                        android:src="@drawable/ic_landmarks"
                        android:tint="@color/ix_accent" />

                    <TextView
                        style="@style/FaceModeCellLabel"
                        android:text="@string/mode_landmarks" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMatch"
                    style="@style/FaceModeCell"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/mode_match"
                        android:src="@drawable/ic_person_search"
                        android:tint="@color/ix_accent" />

                    <TextView
                        style="@style/FaceModeCellLabel"
                        android:text="@string/mode_match" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnLiveness"
                    style="@style/FaceModeCell"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="@string/mode_liveness"
                        android:src="@drawable/ic_liveness"
                        android:tint="@color/ix_accent" />

                    <TextView
                        style="@style/FaceModeCellLabel"
                        android:text="@string/mode_liveness" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/group_identity"
            android:textColor="@color/ix_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnEnroll"
                style="@style/FaceModeTile"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/mode_enroll"
                    android:src="@drawable/ic_person_add"
                    android:tint="@color/ix_accent" />

                <TextView
                    style="@style/FaceModeTileLabel"
                    android:text="@string/mode_enroll" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnIdentity"
                style="@style/FaceModeTile"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_btn_purple"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/mode_identity"
                    android:src="@drawable/ic_identity"
                    android:tint="@color/ix_on_accent" />

                <TextView
                    style="@style/FaceModeTileLabel"
                    android:text="@string/mode_identity"
                    android:textColor="@color/ix_on_accent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnEnrolledList"
                style="@style/FaceModeTile"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/mode_enrolled_list"
                    android:src="@drawable/ic_people"
                    android:tint="@color/ix_accent" />

                <TextView
                    style="@style/FaceModeTileLabel"
                    android:text="@string/mode_enrolled_list" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/settings"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/ix_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/settings"
                    android:textColor="@color/ix_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAbout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/about_title"
                    android:src="@drawable/ic_info"
                    android:tint="@color/ix_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/about_title"
                    android:textColor="@color/ix_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/ix_text"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
